---
import Window from './Window.astro';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<Window title="~/mon-portfolio — claude" tone="dark" class={cls}>
  <div class="term" aria-label="Exemple de session dans le terminal" role="img">
    <p class="you"><span class="pr">›</span> Fais-moi une page portfolio : une grille de projets, un bouton mode sombre, et que ce soit joli sur téléphone.</p>

    <p class="agent"><span class="dot">●</span> Je lis le projet… <span class="dim">Astro · 12 fichiers · pas encore de tests</span></p>

    <div class="plan">
      <p class="lbl">Plan proposé</p>
      <ol>
        <li>Créer la grille <span class="file">src/components/Grille.astro</span></li>
        <li>Ajouter le bouton clair / sombre</li>
        <li>Vérifier sur mobile et lancer le build</li>
      </ol>
      <p class="ask">Je continue ? <span class="key">oui</span></p>
    </div>

    <ul class="files">
      <li><span class="op">✎</span> <span class="file">src/components/Grille.astro</span><span class="stat"><b>+64</b></span></li>
      <li><span class="op">✎</span> <span class="file">src/pages/index.astro</span><span class="stat"><b>+12</b> −3</span></li>
      <li><span class="op">✎</span> <span class="file">src/styles/theme.css</span><span class="stat"><b>+18</b></span></li>
    </ul>

    <p class="ok"><span class="chk">✓</span> build ok · commit <span class="msg">« portfolio : grille + mode sombre »</span></p>
    <p class="you idle"><span class="pr">›</span> <span class="cursor" aria-hidden="true"></span></p>
  </div>
</Window>
<style>
  .term { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.65; color: #d4d4d4; padding: 18px 20px 20px; display: grid; gap: 12px; }
  .pr { color: var(--dark-muted); margin-right: 4px; }
  .you { color: #fafafa; }
  .dot { color: #fafafa; margin-right: 4px; }
  .dim { color: #6b6b6b; }
  .plan { border: 1px solid var(--dark-3); border-radius: 10px; padding: 10px 14px; background: var(--dark-2); }
  .lbl { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--dark-muted); margin-bottom: 4px; }
  ol { margin: 0; padding-left: 18px; }
  .file { color: #fafafa; text-decoration: underline; text-decoration-color: #3a3a3a; text-underline-offset: 3px; }
  .ask { margin-top: 6px; color: var(--dark-muted); }
  .key { color: var(--dark); background: #e5e5e5; border-radius: 4px; padding: 0 6px; }
  .files { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .files li { display: flex; gap: 8px; }
  .op { color: var(--dark-muted); }
  .stat { margin-left: auto; color: #6b6b6b; padding-left: 12px; white-space: nowrap; }
  .stat b { color: #e5e5e5; font-weight: 500; }
  .ok { color: #fafafa; }
  .chk { display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; background: #fafafa; color: var(--dark); font-size: 10px; margin-right: 4px; }
  .msg { color: var(--dark-muted); }
  .idle { margin-top: 2px; }
  .cursor { display: inline-block; width: 8px; height: 15px; background: #fafafa; vertical-align: -3px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 520px) {
    .term { font-size: 11.5px; padding: 14px 14px 16px; }
    .stat { display: none; }
  }
</style>
