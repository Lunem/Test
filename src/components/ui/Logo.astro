---
interface Props { inverted?: boolean }
const { inverted = false } = Astro.props;
---
<a href="/" class:list={['logo', { inverted }]} aria-label="croquis — accueil">
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="9" class="tile" />
    <path d="M9 11l5 5-5 5" class="chev" />
    <rect x="16" y="19.5" width="7" height="2.6" rx="1.3" class="caret" />
  </svg>
  <span class="word">croquis</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; font-size: 1.0625rem; letter-spacing: -0.03em; }
  .mark { width: 26px; height: 26px; transition: transform .4s var(--ease-out); }
  .tile { fill: var(--ink); }
  .chev { fill: none; stroke: var(--bg); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .caret { fill: var(--bg); animation: blink 1.1s steps(1) infinite; }
  .inverted .tile { fill: var(--dark-ink); }
  .inverted .chev { stroke: var(--dark); }
  .inverted .caret { fill: var(--dark); }
  .logo:hover .mark { transform: rotate(-8deg) scale(1.06); }
  @keyframes blink { 50% { opacity: 0; } }
</style>
